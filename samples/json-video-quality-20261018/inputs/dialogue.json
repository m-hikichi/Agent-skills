          }
        },
        {
          "id": "intro-steps",
          "speakerId": "narrator",
          "text": "検証、音声生成、絵コンテ確認、レンダーの順に処理します。",
          "visual": {
            "type": "bullets",
            "title": "再現可能な4段階",
            "items": [
              "Schemaで入力を検証",
              "VOICEVOXで発話音声を生成",
              "storyboardを目視確認",
              "固定lockからMP4をレンダー"
            ]
          }
        }
      ]
    },
