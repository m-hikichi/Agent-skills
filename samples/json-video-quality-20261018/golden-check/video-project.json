{
  "schemaVersion": "1.0.0",
  "meta": {
    "id": "all-templates",
    "title": "8種類のVisualテンプレート",
    "description": "VOICEVOXを使わず、固定された8種類のvisualを1本で確認するサンプルです。",
    "language": "ja-JP"
  },
  "canvas": {
    "preset": "youtube-1080p",
    "fps": 30
  },
  "theme": {
    "backgroundColor": "#0F172A",
    "foregroundColor": "#F8FAFC",
    "accentColor": "#22D3EE",
    "fontFamily": "Noto Sans CJK JP",
    "spacing": "comfortable",
    "subtitleStyle": {
      "fontSize": 50,
      "maxLines": 2,
      "backgroundColor": "#020617DD",
      "color": "#FFFFFF"
    }
  },
  "assets": [
    {
      "id": "template-media",
      "type": "image",
      "path": "assets/all-templates-media.png",
      "rights": {
        "status": "unknown",
        "source": "replace with the selected local asset source",
        "attribution": "confirm after replacing the placeholder"
      }
    }
  ],
  "speakers": [],
  "sections": [
    {
      "id": "templates-a",
      "title": "基本レイアウト",
      "scenes": [
        {
          "id": "template-title",
          "durationMs": 1800,
          "visual": {
            "type": "title",
            "title": "8種類のVisual",
            "subtitle": "安全な固定テンプレートをまとめて確認"
          }
        },
        {
          "id": "template-bullets",
          "durationMs": 1800,
          "visual": {
            "type": "bullets",
            "title": "JSONから指定できる内容",
            "items": [
              "台詞と字幕",
              "画面レイアウト",
              "色と余白"
            ]
          }
        },
        {
          "id": "template-split",
          "durationMs": 1800,
          "visual": {
            "type": "split",
            "leftTitle": "入力",
            "left": "構造化されたvideo-project.json",
            "rightTitle": "出力",
            "right": "再現可能な動画と付属ファイル"
          }
        },
        {
          "id": "template-media",
          "durationMs": 1800,
          "visual": {
            "type": "media",
            "assetId": "template-media",
            "caption": "ローカル素材だけを参照します",
            "fit": "contain"
          }
        }
      ]
    },
    {
      "id": "templates-b",
      "title": "情報表現",
      "scenes": [
        {
          "id": "template-code",
          "durationMs": 1800,
          "visual": {
            "type": "code",
            "variant": "source",
            "title": "静的な表示例",
            "language": "json",
            "code": "{\n  \"schemaVersion\": \"1.0.0\",\n  \"canvas\": {\"fps\": 30}\n}"
          }
        },
        {
          "id": "template-quote",
          "durationMs": 1800,
          "visual": {
            "type": "quote",
            "quote": "編集JSONと生成lockを分けることで、入力と再現条件を明確にします。",
            "attribution": "JSON Video Studio"
          }
        },
        {
          "id": "template-metric",
          "durationMs": 1800,
          "visual": {
            "type": "metric",
            "variant": "line",
            "label": "sceneごとの確認進捗",
            "values": [
              1,
              3,
              5,
              8
            ],
            "labels": [
              "企画",
              "検証",
              "レビュー",
              "完成"
            ]
          }
        },
        {
          "id": "template-outro",
          "durationMs": 1800,
          "visual": {
            "type": "outro",
            "title": "8種類すべて確認完了",
            "subtitle": "次はthemeと内容を自分の企画に合わせて編集"
          }
        }
      ]
    }
  ],
  "audio": {
    "bgmVolume": 0.12,
    "sfxVolume": 0.5
  },
  "thumbnail": {
    "textLines": [
      "8種類のVisual",
      "まとめて確認"
    ],
    "layout": "center"
  },
  "outputs": {
    "video": true,
    "captions": true,
    "chapters": true,
    "thumbnail": true,
    "storyboard": true
  },
  "policies": {
    "allowUnknownRights": true,
    "maxDurationMinutes": 1
  }
}
