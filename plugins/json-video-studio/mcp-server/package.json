{
  "name": "json-video-studio-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "json-video": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": false
  },
  "scripts": {
    "build": "npm run generate:types && npm run build:web && tsc -p tsconfig.json",
    "build:web": "vite build",
    "generate:types": "node scripts/generate-types.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "start": "node dist/cli/index.js",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.3.0",
    "@fastify/static": "10.1.2",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@remotion/bundler": "4.0.503",
    "@remotion/media": "4.0.503",
    "@remotion/player": "4.0.503",
    "@remotion/renderer": "4.0.503",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^14.0.1",
    "fastify": "^5.6.0",
    "mime-types": "^3.0.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "remotion": "4.0.503",
    "zod": "^4.1.0"
  },
  "overrides": {
    "hono": "4.12.34",
    "nanoid": "3.3.17"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^24.7.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "json-schema-to-typescript": "^15.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  }
}
