{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://json-video-studio.local/schemas/video-project.schema.json",
  "title": "JSON Video Studio project",
  "description": "Authoring contract for json-video/v1. All asset paths are local and relative to the project file.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "meta",
    "canvas",
    "theme",
    "assets",
    "speakers",
    "sections",
    "thumbnail",
    "outputs",
    "policies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "canvas": {
      "$ref": "#/$defs/canvas"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      },
      "maxItems": 500
    },
    "speakers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/speaker"
      },
      "maxItems": 20
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/section"
      },
      "minItems": 1,
      "maxItems": 100
    },
    "navigation": {
      "$ref": "#/$defs/navigation"
    },
    "audio": {
      "$ref": "#/$defs/audioMix"
    },
    "pronunciations": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["term", "reading"],
        "properties": {
          "term": {"type": "string", "minLength": 1, "maxLength": 100, "pattern": "\\S"},
          "reading": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S"}
        }
      }
    },
    "thumbnail": {
      "$ref": "#/$defs/thumbnail"
    },
    "outputs": {
      "$ref": "#/$defs/outputs"
    },
    "policies": {
      "$ref": "#/$defs/policies"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"
    },
    "localPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![A-Za-z]:)(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$))(?![A-Za-z][A-Za-z0-9+.-]*:)[^\\u0000-\\u001F]+$"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "language"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        },
        "language": {
          "const": "ja-JP"
        }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset",
        "fps"
      ],
      "properties": {
        "preset": {
          "const": "youtube-1080p"
        },
        "fps": {
          "const": 30
        }
      }
    },
    "subtitleStyle": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fontSize": {
          "type": "number",
          "minimum": 28,
          "maximum": 96
        },
        "maxLines": {
          "enum": [
            1,
            2
          ]
        },
        "backgroundColor": {
          "$ref": "#/$defs/color"
        },
        "color": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "theme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backgroundColor",
        "foregroundColor",
        "accentColor",
        "fontFamily"
      ],
      "properties": {
        "backgroundColor": {
          "$ref": "#/$defs/color"
        },
        "foregroundColor": {
          "$ref": "#/$defs/color"
        },
        "accentColor": {
          "$ref": "#/$defs/color"
        },
        "fontFamily": {
          "const": "Noto Sans CJK JP",
          "description": "v0.1 uses the Noto Sans CJK JP family bundled in the Docker image so resolved and rendered output use the same locked font."
        },
        "spacing": {
          "enum": [
            "compact",
            "comfortable"
          ]
        },
        "subtitleStyle": {
          "$ref": "#/$defs/subtitleStyle"
        },
        "frame": {
          "$ref": "#/$defs/frame"
        }
      }
    },
    "frame": {
      "description": "Slide-deck frame: gradient background, white content card, footer with logo, footer text and page number, chapter chips and progress line at the bottom, and a cover layout for title/outro visuals. Colors come from palette (brand-neutral defaults).",
      "type": "object", "additionalProperties": false, "required": ["style"],
      "properties": {
        "style": {"const": "deck"},
        "palette": {
          "description": "Frame colors. Omitted keys fall back to neutral defaults.",
          "type": "object", "additionalProperties": false,
          "properties": {
            "gradientStart": {"$ref": "#/$defs/color"},
            "gradientEnd": {"$ref": "#/$defs/color"},
            "primary": {"$ref": "#/$defs/color"},
            "dark": {"$ref": "#/$defs/color"},
            "light": {"$ref": "#/$defs/color"},
            "text": {"$ref": "#/$defs/color"},
            "marker": {"$ref": "#/$defs/color"}
          }
        },
        "footerLogoAssetId": {"$ref": "#/$defs/identifier"},
        "coverLogoAssetId": {"$ref": "#/$defs/identifier"},
        "coverMarkAssetId": {"$ref": "#/$defs/identifier"},
        "footerText": {"type": "string", "minLength": 1, "maxLength": 60},
        "coverCaption": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "owned",
            "licensed",
            "public-domain",
            "unknown"
          ]
        },
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "attribution": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "licensed"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "license": {"type": "string", "minLength": 1, "maxLength": 200}
            },
            "required": [
              "license"
            ]
          }
        }
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "path",
        "rights"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "enum": [
            "image",
            "video",
            "audio",
            "font",
            "avatar"
          ]
        },
        "path": {
          "$ref": "#/$defs/localPath"
        },
        "rights": {
          "$ref": "#/$defs/rights"
        }
      }
    },
    "voicevoxVoice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "speakerUuid",
        "styleId"
      ],
      "properties": {
        "provider": {
          "const": "voicevox"
        },
        "speakerUuid": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$"
        },
        "styleId": {
          "type": "integer",
          "minimum": 0
        },
        "speedScale": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        },
        "volumeScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "pitchScale": {
          "type": "number",
          "minimum": -0.15,
          "maximum": 0.15
        },
        "intonationScale": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        }
      }
    },
    "avatar": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaultAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "mouthOpenAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "expressions": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/identifier"
          },
          "additionalProperties": {
            "$ref": "#/$defs/identifier"
          },
          "maxProperties": 20
        }
      }
    },
    "speaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "displayName"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "voice": {
          "$ref": "#/$defs/voicevoxVoice"
        },
        "avatar": {
          "$ref": "#/$defs/avatar"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 2
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2
        }
      }
    },
    "titleVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "const": "title"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subtitle": {
          "type": "string",
          "maxLength": 180
        }
      }
    },
    "bulletsVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "items"
      ],
      "properties": {
        "type": {
          "const": "bullets"
        },
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "minItems": 1,
          "maxItems": 5
        },
        "highlight": {
          "description": "Zero-based item indexes to emphasize. Other items are dimmed. Consecutive scenes that differ only by highlight keep the layout on screen.",
          "type": "array", "uniqueItems": true, "maxItems": 5,
          "items": {"type": "integer", "minimum": 0, "maximum": 4}
        }
      }
    },
    "splitVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "left",
        "right"
      ],
      "properties": {
        "type": {
          "const": "split"
        },
        "left": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "right": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "leftTitle": {
          "type": "string",
          "maxLength": 80
        },
        "rightTitle": {
          "type": "string",
          "maxLength": 80
        }
      }
    },
    "mediaVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "assetId"
      ],
      "properties": {
        "type": {
          "const": "media"
        },
        "assetId": {
          "$ref": "#/$defs/identifier"
        },
        "caption": {
          "type": "string",
          "maxLength": 180
        },
        "fit": {
          "enum": [
            "contain",
            "cover"
          ]
        }
      }
    },
    "codeVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "variant",
        "code"
      ],
      "properties": {
        "type": {
          "const": "code"
        },
        "variant": {
          "enum": [
            "source",
            "diff",
            "terminal"
          ]
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "language": {
          "type": "string",
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "maxLength": 100
        }
      }
    },
    "quoteVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "quote"
      ],
      "properties": {
        "type": {
          "const": "quote"
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 400
        },
        "attribution": {
          "type": "string",
          "maxLength": 160
        }
      }
    },
    "metricVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "variant",
        "label"
      ],
      "properties": {
        "type": {
          "const": "metric"
        },
        "variant": {
          "enum": [
            "number",
            "bar",
            "line"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "values": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 12
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 40
          },
          "minItems": 1,
          "maxItems": 12
        }
      },
      "oneOf": [
        {
          "properties": {
            "variant": {
              "const": "number"
            },
            "value": {"type": "string", "minLength": 1, "maxLength": 60}
          },
          "required": [
            "value"
          ],
          "not": {
            "anyOf": [
              {
                "properties": {
                  "values": {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 12}
                },
                "required": [
                  "values"
                ]
              },
              {
                "properties": {
                  "labels": {"type": "array", "items": {"type": "string", "maxLength": 40}, "minItems": 1, "maxItems": 12}
                },
                "required": [
                  "labels"
                ]
              }
            ]
          }
        },
        {
          "properties": {
            "variant": {
              "enum": [
                "bar",
                "line"
              ]
            },
            "values": {"type": "array", "items": {"type": "number"}, "minItems": 1, "maxItems": 12}
          },
          "required": [
            "values"
          ],
          "not": {
            "properties": {
              "value": {"type": "string", "minLength": 1, "maxLength": 60}
            },
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "outroVisual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "title"
      ],
      "properties": {
        "type": {
          "const": "outro"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subtitle": {
          "type": "string",
          "maxLength": 180
        }
      }
    },
    "flowVisual": {
      "type": "object", "additionalProperties": false, "required": ["type", "steps", "activeStep"],
      "properties": {
        "type": {"const": "flow"},
        "title": {"type": "string", "minLength": 1, "maxLength": 60},
        "steps": {
          "type": "array", "minItems": 2, "maxItems": 4,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["title"],
            "properties": {
              "title": {"type": "string", "minLength": 1, "maxLength": 20},
              "detail": {"type": "string", "minLength": 1, "maxLength": 45}
            }
          }
        },
        "activeStep": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "tableVisual": {
      "type": "object", "additionalProperties": false, "required": ["type", "columns", "rows"],
      "properties": {
        "type": {"const": "table"},
        "title": {"type": "string", "maxLength": 100},
        "columns": {
          "type": "array", "minItems": 1, "maxItems": 5,
          "items": {"type": "string", "minLength": 1, "maxLength": 20}
        },
        "rows": {
          "type": "array", "minItems": 1, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["label", "cells"],
            "properties": {
              "label": {"type": "string", "minLength": 1, "maxLength": 30},
              "cells": {
                "type": "array", "minItems": 1, "maxItems": 5,
                "items": {"type": "string", "minLength": 1, "maxLength": 20}
              }
            }
          }
        },
        "highlightRows": {
          "description": "Zero-based row indexes to emphasize.",
          "type": "array", "uniqueItems": true, "maxItems": 6,
          "items": {"type": "integer", "minimum": 0, "maximum": 5}
        },
        "highlightColumns": {
          "description": "Zero-based column indexes to emphasize.",
          "type": "array", "uniqueItems": true, "maxItems": 5,
          "items": {"type": "integer", "minimum": 0, "maximum": 4}
        },
        "note": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "statementVisual": {
      "type": "object", "additionalProperties": false, "required": ["type", "text"],
      "properties": {
        "type": {"const": "statement"},
        "label": {"type": "string", "minLength": 1, "maxLength": 30},
        "title": {"type": "string", "minLength": 1, "maxLength": 60},
        "text": {"type": "string", "minLength": 1, "maxLength": 200},
        "emphasis": {
          "description": "Exact substrings of text to emphasize with the accent color.",
          "type": "array", "maxItems": 6,
          "items": {"type": "string", "minLength": 1, "maxLength": 40}
        }
      }
    },
    "emphasisTerms": {
      "description": "Exact substrings of the block text to emphasize.",
      "type": "array", "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 60}
    },
    "highlightIndexes": {
      "description": "Zero-based item indexes to emphasize; the other items are dimmed.",
      "type": "array", "uniqueItems": true, "maxItems": 8,
      "items": {"type": "integer", "minimum": 0, "maximum": 7}
    },
    "blockSpan": {"description": "Width in a 12-column grid.", "type": "integer", "minimum": 1, "maximum": 12},
    "slideBlock": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "text"],
          "properties": {
            "kind": {"const": "text"},
            "span": {"$ref": "#/$defs/blockSpan"},
            "label": {"type": "string", "minLength": 1, "maxLength": 30},
            "heading": {"type": "string", "minLength": 1, "maxLength": 40},
            "text": {"type": "string", "minLength": 1, "maxLength": 300},
            "emphasis": {"$ref": "#/$defs/emphasisTerms"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "text"],
          "properties": {
            "kind": {"const": "callout"},
            "span": {"$ref": "#/$defs/blockSpan"},
            "text": {"type": "string", "minLength": 1, "maxLength": 200},
            "emphasis": {"$ref": "#/$defs/emphasisTerms"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "columns", "rows"],
          "properties": {
            "kind": {"const": "table"},
            "span": {"$ref": "#/$defs/blockSpan"},
            "heading": {"type": "string", "minLength": 1, "maxLength": 40},
            "labelHeader": {"type": "string", "minLength": 1, "maxLength": 20},
            "columns": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 24}},
            "rows": {
              "type": "array", "minItems": 1, "maxItems": 8,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["label", "cells"],
                "properties": {
                  "label": {"type": "string", "minLength": 1, "maxLength": 30},
                  "cells": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 40}}
                }
              }
            },
            "highlightRows": {"$ref": "#/$defs/highlightIndexes"},
            "highlightColumns": {"$ref": "#/$defs/highlightIndexes"},
            "note": {"type": "string", "minLength": 1, "maxLength": 120}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "items"],
          "properties": {
            "kind": {"const": "cards"},
            "span": {"$ref": "#/$defs/blockSpan"},
            "items": {
              "type": "array", "minItems": 1, "maxItems": 4,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["title", "body"],
                "properties": {
                  "title": {"type": "string", "minLength": 1, "maxLength": 24},
                  "body": {"type": "string", "minLength": 1, "maxLength": 120},
                  "note": {"type": "string", "minLength": 1, "maxLength": 60}
                }
              }
            },
            "highlight": {"$ref": "#/$defs/highlightIndexes"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "items"],
          "properties": {
            "kind": {"const": "kpis"},
            "span": {"$ref": "#/$defs/blockSpan"},
            "items": {
              "type": "array", "minItems": 1, "maxItems": 4,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["label", "value"],
                "properties": {
                  "label": {"type": "string", "minLength": 1, "maxLength": 30},
                  "value": {"type": "string", "minLength": 1, "maxLength": 20},
                  "note": {"type": "string", "minLength": 1, "maxLength": 50}
                }
              }
            },
            "highlight": {"$ref": "#/$defs/highlightIndexes"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "items"],
          "properties": {
            "kind": {"const": "list"},
            "span": {"$ref": "#/$defs/blockSpan"},
            "heading": {"type": "string", "minLength": 1, "maxLength": 40},
            "items": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
            "highlight": {"$ref": "#/$defs/highlightIndexes"}
          }
        },
        {
          "type": "object", "additionalProperties": false, "required": ["kind", "items"],
          "properties": {
            "kind": {"const": "steps"},
            "span": {"$ref": "#/$defs/blockSpan"},
            "items": {
              "type": "array", "minItems": 2, "maxItems": 6,
              "items": {
                "type": "object", "additionalProperties": false, "required": ["title"],
                "properties": {
                  "title": {"type": "string", "minLength": 1, "maxLength": 16},
                  "detail": {"type": "string", "minLength": 1, "maxLength": 30}
                }
              }
            },
            "highlight": {"$ref": "#/$defs/highlightIndexes"}
          }
        }
      ]
    },
    "slideVisual": {
      "description": "A composed slide page: tag + title header and up to six blocks in a 12-column grid. Consecutive scenes with the same slide keep the page on screen and only move emphasis.",
      "type": "object", "additionalProperties": false, "required": ["type", "title", "blocks"],
      "properties": {
        "type": {"const": "slide"},
        "tag": {"type": "string", "minLength": 1, "maxLength": 16},
        "title": {"type": "string", "minLength": 1, "maxLength": 48},
        "blocks": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/slideBlock"}}
      }
    },
    "navigation": {
      "description": "Persistent chapter bar shown above every scene. Each group bundles one or more sections in order.",
      "type": "object", "additionalProperties": false, "required": ["groups"],
      "properties": {
        "groups": {
          "type": "array", "minItems": 2, "maxItems": 6,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["title", "sectionIds"],
            "properties": {
              "title": {"type": "string", "minLength": 1, "maxLength": 16},
              "sectionIds": {
                "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
                "items": {"$ref": "#/$defs/identifier"}
              }
            }
          }
        }
      }
    },
    "sceneVisual": {
      "oneOf": [
        {
          "$ref": "#/$defs/titleVisual"
        },
        {
          "$ref": "#/$defs/bulletsVisual"
        },
        {
          "$ref": "#/$defs/splitVisual"
        },
        {
          "$ref": "#/$defs/mediaVisual"
        },
        {
          "$ref": "#/$defs/codeVisual"
        },
        {
          "$ref": "#/$defs/quoteVisual"
        },
        {
          "$ref": "#/$defs/metricVisual"
        },
        {
          "$ref": "#/$defs/outroVisual"
        },
        {
          "$ref": "#/$defs/flowVisual"
        },
        {
          "$ref": "#/$defs/tableVisual"
        },
        {
          "$ref": "#/$defs/statementVisual"
        },
        {
          "$ref": "#/$defs/slideVisual"
        }
      ]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "visual"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "speakerId": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "subtitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "speechText": {
          "description": "Explicit synthesis text; overrides the project pronunciation dictionary without changing displayed text or subtitles.",
          "type": "string", "minLength": 1, "maxLength": 2000, "pattern": "\\S"
        },
        "emotion": {
          "$ref": "#/$defs/identifier"
        },
        "audioAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "sfxAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "durationMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 3600000
        },
        "holdAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "visual": {
          "$ref": "#/$defs/sceneVisual"
        }
      },
      "oneOf": [
        {
          "description": "A user-supplied audio asset determines the duration. speakerId and text may still drive avatar and subtitles.",
          "properties": {
            "audioAssetId": {"$ref": "#/$defs/identifier"}
          },
          "required": [
            "audioAssetId"
          ],
          "not": {
            "properties": {
              "durationMs": {"type": "integer", "minimum": 100, "maximum": 3600000}
            },
            "required": [
              "durationMs"
            ]
          }
        },
        {
          "description": "VOICEVOX generates audio from a speaker and text.",
          "properties": {
            "speakerId": {"$ref": "#/$defs/identifier"},
            "text": {"type": "string", "minLength": 1, "maxLength": 2000}
          },
          "required": [
            "speakerId",
            "text"
          ],
          "not": {
            "anyOf": [
              {
                "properties": {
                  "audioAssetId": {"$ref": "#/$defs/identifier"}
                },
                "required": [
                  "audioAssetId"
                ]
              },
              {
                "properties": {
                  "durationMs": {"type": "integer", "minimum": 100, "maximum": 3600000}
                },
                "required": [
                  "durationMs"
                ]
              }
            ]
          }
        },
        {
          "description": "A silent scene has an explicit duration and no speaker or audio asset.",
          "properties": {
            "durationMs": {"type": "integer", "minimum": 100, "maximum": 3600000}
          },
          "required": [
            "durationMs"
          ],
          "not": {
            "anyOf": [
              {
                "properties": {
                  "audioAssetId": {"$ref": "#/$defs/identifier"}
                },
                "required": [
                  "audioAssetId"
                ]
              },
              {
                "properties": {
                  "speakerId": {"$ref": "#/$defs/identifier"}
                },
                "required": [
                  "speakerId"
                ]
              }
            ]
          }
        }
      ]
    },
    "section": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "scenes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "backgroundAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "bgmAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/scene"
          },
          "minItems": 1,
          "maxItems": 1000
        }
      }
    },
    "audioMix": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "bgmAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "bgmVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "sfxVolume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "textLines"
      ],
      "properties": {
        "backgroundAssetId": {
          "$ref": "#/$defs/identifier"
        },
        "textLines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "minItems": 1,
          "maxItems": 2
        },
        "speakerIds": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/identifier"
          },
          "uniqueItems": true,
          "maxItems": 2
        },
        "layout": {
          "enum": [
            "left",
            "center",
            "right"
          ]
        }
      }
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "video",
        "captions",
        "chapters",
        "thumbnail",
        "storyboard"
      ],
      "properties": {
        "video": {
          "const": true,
          "description": "v0.1 always renders the primary MP4."
        },
        "captions": {
          "type": "boolean"
        },
        "chapters": {
          "type": "boolean"
        },
        "thumbnail": {
          "type": "boolean"
        },
        "storyboard": {
          "const": true,
          "description": "v0.1 always generates storyboard assets for the mandatory review gate."
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowUnknownRights",
        "maxDurationMinutes"
      ],
      "properties": {
        "allowUnknownRights": {
          "type": "boolean"
        },
        "maxDurationMinutes": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 180
        }
      }
    }
  }
}
