      ],
      "status": "future"
    }
  ],
  "function_list": [
    {
      "name": "注文受付",
      "id": "01",
      "children": [
        {
          "name": "API受付",
          "id": "01",
          "children": [
            {
              "name": "登録",
              "id": "01",
              "rows": [
                {
                  "id": "FNC-001",
                  "name": "注文登録",
                  "summary": "外部ECから注文を受け付けて注文IDを発行する",
                  "actors": [
                    "外部EC"
                  ],
                  "trigger": "外部ECが注文登録APIを呼び出す",
                  "execution": {
                    "type": "api",
                    "refs": [
                      "API-001"
                    ]
                  },
                  "inputs": [
                    "注文番号",
                    "商品明細",
                    "配送先",
                    "冪等キー"
                  ],
                  "outputs": [
                    "注文ID",
                    "受付結果"
                  ],
                  "preconditions": [
                    "入力必須項目が指定されている"
                  ],
                  "postconditions": [
                    "注文が受付済みで保存される"
                  ],
                  "business_rules": [
                    {
                      "id": "BR-001-01",
                      "text": "正常な注文を受付済みとして登録し注文IDを返す",
                      "basis": "specified",
                      "source_refs": [
                        "FR-001",
                        "AC-001-01"
                      ]
                    }
                  ],
                  "exceptions": [
                    {
                      "condition": "入力必須項目が不足する",
                      "behavior": "注文を作成せず入力エラーを返す",
                      "basis": "derived",
                      "source_refs": [
                        "FR-001"
                      ],
                      "rationale": "FR-001で列挙された入力を満たさない要求から完全な注文を作成できないため"
                    }
                  ],
                  "data_entities": [
                    "注文",
                    "注文明細"
                  ],
                  "source_refs": [
                    "US-001",
                    "AC-001-01",
                    "FR-001",
                    "SC-001"
                  ],
                  "status": "current"
                },
                {
                  "id": "FNC-002",
                  "name": "冪等受付制御",
                  "summary": "冪等キーにより注文の重複作成を防止する",
                  "actors": [
                    "外部EC"
                  ],
                  "trigger": "注文登録APIが冪等キー付き要求を受信する",
                  "execution": {
                    "type": "api",
                    "refs": [
                      "API-001"
                    ]
                  },
                  "inputs": [
                    "冪等キー",
                    "注文登録要求"
                  ],
                  "outputs": [
                    "初回受付時の注文IDと受付結果"
                  ],
                  "preconditions": [
                    "外部ECが注文ごとに一意な冪等キーを付与する"
                  ],
                  "postconditions": [
                    "同一キーで注文が1件だけ存在する"
                  ],
                  "business_rules": [
                    {
                      "id": "BR-002-01",
                      "text": "同一冪等キーの再送では新規注文を作成せず初回結果を返す",
                      "basis": "confirmed",
                      "source_refs": [
                        "FR-002",
                        "CL-20260621-01",
                        "AC-001-02"
                      ]
                    }
                  ],
                  "exceptions": [],
                  "data_entities": [
                    "注文",
                    "冪等受付結果"
                  ],
                  "source_refs": [
                    "US-001",
                    "AC-001-02",
                    "CL-20260621-01",
                    "FR-002",
                    "SC-002",
                    "ASM-001"
                  ],
                  "status": "current"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "注文状態",
      "id": "02",
      "children": [
        {
          "name": "状態管理",
          "id": "01",
          "children": [
            {
              "name": "状態遷移",
              "id": "01",
              "rows": [
                {
                  "id": "FNC-003",
                  "name": "注文状態遷移",
                  "summary": "許可された条件に従って注文状態を変更する",
                  "actors": [
                    "注文管理システム"
                  ],
                  "trigger": "出荷・配送・取消処理が状態変更を要求する",
                  "execution": {
                    "type": "event",
                    "refs": [
                      "EVT-001"
                    ]
                  },
                  "inputs": [
                    "注文ID",
                    "変更要求状態"
                  ],
                  "outputs": [
                    "変更後状態",
                    "拒否理由"
                  ],
                  "preconditions": [
                    "対象注文が存在する"
                  ],
                  "postconditions": [
                    "許可時だけ注文状態が更新される",
                    "拒否時は現在状態を維持する"
                  ],
                  "business_rules": [
                    {
                      "id": "BR-010-01",
                      "text": "受付済み・配送中・配送済み・取消の許可条件に従って遷移する",
                      "basis": "specified",
                      "source_refs": [
                        "FR-010"
                      ]
                    },
                    {
                      "id": "BR-011-01",
                      "text": "配送済みから取消への変更を拒否する",
                      "basis": "confirmed",
                      "source_refs": [
                        "FR-011",
                        "EC-001",
                        "CL-20260621-02"
                      ]
                    }
                  ],
                  "exceptions": [
                    {
                      "condition": "禁止された状態遷移を要求する",
                      "behavior": "状態を変更せず拒否理由を返す",
                      "basis": "specified",
                      "source_refs": [
                        "FR-011",
                        "EC-001"
                      ]
                    }
                  ],
                  "data_entities": [
                    "注文",
                    "注文状態履歴"
                  ],
                  "source_refs": [
                    "FR-010",
                    "FR-011",
                    "EC-001",
                    "CL-20260621-02"
                  ],
                  "status": "current"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "name": "外部連携",
      "id": "03",
      "children": [
        {
          "name": "状態通知",
          "id": "01",
          "children": [
            {
              "name": "イベント送信",
              "id": "01",
              "rows": [
                {
                  "id": "FNC-004",
                  "name": "状態変更イベント送信",
                  "summary": "注文状態の変更内容を外部ECへ通知する",
                  "actors": [
                    "外部EC"
                  ],
                  "trigger": "注文状態が正常に変更される",
                  "execution": {
                    "type": "external-interface",
                    "refs": [
                      "EXT-001"
                    ]
                  },
                  "inputs": [
                    "注文ID",
                    "変更前状態",
                    "変更後状態",
                    "変更日時"
                  ],
                  "outputs": [
                    "状態変更イベント",
                    "送信結果"
                  ],
                  "preconditions": [
                    "注文状態変更が確定している"
                  ],
                  "postconditions": [
                    "送信結果が記録される"
                  ],
                  "business_rules": [
                    {
                      "id": "BR-020-01",
                      "text": "注文ID、変更前後の状態、変更日時をイベントに含める",
                      "basis": "specified",
                      "source_refs": [
                        "FR-020"
                      ]
                    },
                    {
                      "id": "BR-020-02",
                      "text": "1回の状態変更につきイベントを1回発行する",
                      "basis": "specified",
                      "source_refs": [
                        "AC-002-01"
                      ]
                    }
                  ],
                  "exceptions": [
                    {
                      "condition": "外部ECへの送信に失敗する",
                      "behavior": "再送対象として記録する",
                      "basis": "specified",
                      "source_refs": [
                        "FR-021",
                        "EC-002"
                      ]
                    }
                  ],
                  "data_entities": [
                    "注文",
                    "状態変更イベント",
                    "イベント送信履歴"
                  ],
                  "source_refs": [
                    "US-002",
                    "AC-002-01",
                    "FR-020",
                    "FR-021",
                    "EC-002",
                    "SC-003"
                  ],
                  "status": "current"
                },
                {
                  "id": "FNC-005",
                  "name": "状態変更イベント再送",
                  "summary": "送信に失敗した状態変更イベントを再送する",
                  "actors": [
                    "システム"
                  ],
                  "trigger": "再送待ちイベントの実行時刻になる",
                  "execution": {
                    "type": "batch",
                    "refs": [
                      "BAT-001"
                    ]
                  },
                  "inputs": [
                    "再送待ちイベント",
                    "過去の送信回数"
                  ],
                  "outputs": [
                    "再送結果",
                    "更新された送信履歴"
                  ],
                  "preconditions": [
                    "イベント送信が失敗している"
                  ],
                  "postconditions": [
                    "成功時は再送完了となる",
                    "上限到達時は再送を終了する"
                  ],
                  "business_rules": [
                    {
                      "id": "BR-021-01",
                      "text": "送信失敗時は最大3回まで再送する",
                      "basis": "specified",
                      "source_refs": [
                        "FR-021",
                        "EC-002"
                      ]
                    },
                    {
                      "id": "BR-021-02",
                      "text": "各再送の日時と結果を履歴へ記録する",
                      "basis": "specified",
                      "source_refs": [
                        "FR-021"
                      ]
                    }
                  ],
                  "exceptions": [
                    {
                      "condition": "3回目の再送も失敗する",
                      "behavior": "再送を終了し最終失敗として記録する",
                      "basis": "derived",
                      "source_refs": [
                        "FR-021",
                        "EC-002"
                      ],
                      "rationale": "最大3回までという上限に達した後は追加再送を行えないため"
                    }
                  ],
                  "data_entities": [
                    "状態変更イベント",
                    "イベント送信履歴"
                  ],
                  "source_refs": [
                    "FR-021",
                    "EC-002",
                    "SC-003"
                  ],
                  "status": "current"
                }
              ]
            }
          ]
        },
        {
          "name": "日次照合",
          "id": "02",
          "children": [
            {
              "name": "件数照合",
              "id": "01",
              "rows": [
                {
                  "id": "FNC-006",
                  "name": "注文件数日次照合",
                  "summary": "外部ECと内部の注文件数を日次で照合する",
                  "actors": [
                    "運用担当者"
                  ],
                  "trigger": "毎日02:00になる",
                  "execution": {
                    "type": "batch",
                    "refs": [
                      "BAT-002"
                    ]
                  },
                  "inputs": [
                    "外部ECの対象日注文件数",
                    "内部の対象日注文件数"
                  ],
                  "outputs": [
                    "照合結果",
                    "不一致通知"
                  ],
                  "preconditions": [
                    "外部ECの件数取得APIを利用できる"
                  ],
                  "postconditions": [
                    "照合結果が保存され、不一致時は運用担当者へ通知される"
                  ],
                  "business_rules": [
                    {
                      "id": "BR-030-01",
                      "text": "毎日02:00に外部ECと内部の注文件数を照合する",
                      "basis": "specified",
                      "source_refs": [
                        "FR-030"
                      ]
                    },
                    {
                      "id": "BR-030-02",
                      "text": "件数不一致を運用担当者へ通知する",
                      "basis": "specified",
                      "source_refs": [
                        "FR-030"
                      ]
                    }
                  ],
                  "exceptions": [
                    {
                      "condition": "外部ECから件数を取得できない",
                      "behavior": "照合不能として運用担当者へ通知する",
                      "basis": "derived",
                      "source_refs": [
                        "FR-030",
                        "ASM-002"
                      ],
                      "rationale": "外部件数がなければ照合結果を確定できず、FR-030の運用通知が必要になるため"
                    }
                  ],
                  "data_entities": [
                    "注文",
                    "日次照合結果"
                  ],
                  "source_refs": [
                    "FR-030",
                    "ASM-002"
                  ],
                  "status": "current"
                }
              ]
            }
          ]
        }
      ]
    },
